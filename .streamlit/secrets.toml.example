# Streamlit Secrets Template for Market-Rover (https://market-rover.streamlit.app)
# Copy this file to .streamlit/secrets.toml (for local dev) or paste into Streamlit Cloud Secrets

# --- Google Gemini AI API Key ---
GOOGLE_API_KEY = "your-gemini-api-key"

# --- Cookie Encryption (for traditional auth fallback) ---
[cookie]
name = "market_rover_session"
key = "super_secret_cookie_key_market_rover_32chars"
expiry_days = 30

# --- Standard Credentials Fallback (Optional) ---
[credentials]
usernames = ["analyst"]
names = ["Lead Analyst"]
passwords = ["rover2026!"]

# --- Multi-Provider Social Authentication (OAuth 2.0) ---

[oauth.google]
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
authorize_endpoint = "https://accounts.google.com/o/oauth2/v2/auth"
token_endpoint = "https://oauth2.googleapis.com/token"
user_info_endpoint = "https://www.googleapis.com/oauth2/v3/userinfo"
redirect_uri = "https://market-rover.streamlit.app"
scope = "openid email profile"

[oauth.github]
client_id = "your-github-client-id"
client_secret = "your-github-client-secret"
authorize_endpoint = "https://github.com/login/oauth/authorize"
token_endpoint = "https://github.com/login/oauth/access_token"
user_info_endpoint = "https://api.github.com/user"
redirect_uri = "https://market-rover.streamlit.app"
scope = "read:user user:email"

[oauth.x]
client_id = "your-x-client-id"
client_secret = "your-x-client-secret"
authorize_endpoint = "https://twitter.com/i/oauth2/authorize"
token_endpoint = "https://api.twitter.com/2/oauth2/token"
user_info_endpoint = "https://api.twitter.com/2/users/me"
redirect_uri = "https://market-rover.streamlit.app"
scope = "users.read tweet.read openid email"

[oauth.linkedin]
client_id = "your-linkedin-client-id"
client_secret = "your-linkedin-client-secret"
authorize_endpoint = "https://www.linkedin.com/oauth/v2/authorization"
token_endpoint = "https://www.linkedin.com/oauth/v2/accessToken"
user_info_endpoint = "https://api.linkedin.com/v2/userinfo"
redirect_uri = "https://market-rover.streamlit.app"
scope = "openid profile email"

[oauth.facebook]
client_id = "your-facebook-app-id"
client_secret = "your-facebook-app-secret"
authorize_endpoint = "https://www.facebook.com/v12.0/dialog/oauth"
token_endpoint = "https://graph.facebook.com/v12.0/oauth/access_token"
user_info_endpoint = "https://graph.facebook.com/me"
redirect_uri = "https://market-rover.streamlit.app"
scope = "email,public_profile"

# --- Whitelist (Optional: leave empty for Open Access) ---
approved_emails = []
