# Streamlit Cloud Secrets Template
# Copy this to .streamlit/secrets.toml and add your actual API keys

GOOGLE_API_KEY = "your-google-api-key-here"

# Optional: Add other configuration
MAX_PARALLEL_STOCKS = 5
RATE_LIMIT_DELAY = 1.0

# ------------------------------------------------------------------
# SOCIAL LOGIN CONFIGURATION (OAuth 2.0)
# ------------------------------------------------------------------

# 1. OPTIONAL: Whitelist specific emails to RESTRICT access.
# If this list is empty or commented out, ANYONE with a valid social account can login.
# approved_emails = ["user1@example.com", "user2@example.com"]

# 2. OAuth Providers
# Get these keys from:
# - Google: https://console.cloud.google.com/apis/credentials
# - GitHub: https://github.com/settings/developers
# - Twitter/X: https://developer.twitter.com/en/portal/dashboard
# - LinkedIn: https://www.linkedin.com/developers/
# - Facebook: https://developers.facebook.com/

[oauth]
# Redirect URI for local development typically: http://localhost:8501/component/streamlit_oauth.authorize_button

[oauth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
redirect_uri = "http://localhost:8501/component/streamlit_oauth.authorize_button"
authorize_endpoint = "https://accounts.google.com/o/oauth2/v2/auth"
token_endpoint = "https://oauth2.googleapis.com/token"
revoke_endpoint = "https://oauth2.googleapis.com/revoke"
user_info_endpoint = "https://www.googleapis.com/oauth2/v3/userinfo"
scope = "openid email profile"
label = "Sign in with Google"
icon = "google"

[oauth.github]
client_id = "YOUR_GITHUB_CLIENT_ID"
client_secret = "YOUR_GITHUB_CLIENT_SECRET"
authorize_endpoint = "https://github.com/login/oauth/authorize"
token_endpoint = "https://github.com/login/oauth/access_token"
user_info_endpoint = "https://api.github.com/user"
redirect_uri = "http://localhost:8501/component/streamlit_oauth.authorize_button"
scope = "read:user user:email"
label = "Sign in with GitHub"
icon = "github"

[oauth.x]
client_id = "YOUR_X_CLIENT_ID"
client_secret = "YOUR_X_CLIENT_SECRET"
authorize_endpoint = "https://twitter.com/i/oauth2/authorize"
token_endpoint = "https://api.twitter.com/2/oauth2/token"
user_info_endpoint = "https://api.twitter.com/2/users/me"
redirect_uri = "http://localhost:8501/component/streamlit_oauth.authorize_button"
scope = "users.read tweet.read openid email"
label = "Sign in with X"
icon = "twitter"

[oauth.linkedin]
client_id = "YOUR_LINKEDIN_CLIENT_ID"
client_secret = "YOUR_LINKEDIN_CLIENT_SECRET"
authorize_endpoint = "https://www.linkedin.com/oauth/v2/authorization"
token_endpoint = "https://www.linkedin.com/oauth/v2/accessToken"
user_info_endpoint = "https://api.linkedin.com/v2/userinfo"
redirect_uri = "http://localhost:8501/component/streamlit_oauth.authorize_button"
scope = "openid profile email"
label = "Sign in with LinkedIn"
icon = "link"

[oauth.facebook]
client_id = "YOUR_FACEBOOK_APP_ID"
client_secret = "YOUR_FACEBOOK_APP_SECRET"
authorize_endpoint = "https://www.facebook.com/v12.0/dialog/oauth"
token_endpoint = "https://graph.facebook.com/v12.0/oauth/access_token"
user_info_endpoint = "https://graph.facebook.com/me"
user_info_params = { fields = "id,name,email" }
redirect_uri = "http://localhost:8501/component/streamlit_oauth.authorize_button"
scope = "email,public_profile"
label = "Sign in with Facebook"
icon = "facebook"
