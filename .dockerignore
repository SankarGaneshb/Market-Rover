# ==============================================================================
# Market-Rover Clean Docker Build Context Ignore List
# ==============================================================================

# Git & VCS
.git
.gitignore
.github
.devcontainer

# Node Dependencies & Coverage
**/node_modules
**/dist
**/build
**/.npm
**/coverage
**/lcov-report

# Python Virtual Envs & Bytecode Caches
.venv
venv
env
ENV
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Tests, Code Coverage & Benchmarks
tests/
htmlcov/
.pytest_cache/
.coverage
.coveragerc
coverage.xml
.benchmarks/
*.egg-info
metrics/

# Temporary Dumps, Logs, Reports & Scripts
*.log
logs/
reports/
output/
uploads/
artifacts/
scratch/
**/scratch/
.agent/
.streamlit/secrets.toml
data/*.db
*.db

# Loose Root Markdown, Text & Diagnostic Logs
*.txt
*.pdf
*.csv
*.md
*.bat
*.ps1

# Assets & Diagrams (Not needed in backend container)
assets/

# IDE & OS Artifacts
.DS_Store
Thumbs.db
.vscode
.idea
*.swp
*.map
